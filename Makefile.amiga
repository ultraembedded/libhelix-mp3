# Convenience build rules for the AmigaOS/m68k decoder frontends.
# Override CC, CPU, OPTFLAGS, TARGET, or EXTRA_CFLAGS from the command line.
# Example:
#   make -f Makefile.amiga fast030
#   make -f Makefile.amiga fast030 CPU=40   # target 68040 instead of the 68030 default

ifeq ($(origin CC),default)
CC := m68k-amigaos-gcc
endif

# objdump used by the CPU=60 audit targets below. Override for a different
# toolchain, e.g. OBJDUMP=m68k-linux-gnu-objdump for codegen inspection.
OBJDUMP ?= m68k-amigaos-objdump

# CPU selects the target processor: 00=68000, 20=68020, 30=68030 (default),
# 40=68040, 60=68060. This is the single source of truth for both the main
# build below AND decoders/Makefile (see decoder-modules further down,
# which forwards this same value) -- there used to be two different,
# inconsistently-propagated notions of "target CPU" here; this replaces
# both.
#
# The hand-written asm in this project (real/amiga_m68k_polyphase.S and
# the AMIGA_M68K_ASM_* inline asm throughout real/*.c) uses 32x32->64
# MULS.L, which does not exist on 68000 -- so CPU=00 excludes that .S file
# entirely (the assembler would hard-fail on it otherwise) and leaves the
# ASM_* defines off, falling back to the C reference paths throughout.
# CPU=20/30/40/60 all get the full asm path; -mCPU alone can't express the
# 68000 asm gap, hence gating CPU_ASM_CPPFLAGS/CPU_ASM_SOURCES on CPU too.
CPU ?= 30
# Decoder-module AAC helpers are on by default; pass AACASM=0 for the portable
# C A/B build. Forwarded explicitly by decoder-modules below.
AACASM ?= 1
# Rockbox WMA fixed-point helpers follow the same opt-out convention.
WMAASM ?= 1
# libfoxenflac LPC restoration helpers; FLACASM=0 keeps portable C.
FLACASM ?= 1
CPU_MFLAG_00 := -m68000
CPU_MFLAG_20 := -m68020
CPU_MFLAG_30 := -m68030
CPU_MFLAG_40 := -m68040
CPU_MFLAG_60 := -m68060
CPU_MFLAG := $(CPU_MFLAG_$(CPU))
ifeq ($(CPU_MFLAG),)
$(error Unknown CPU=$(CPU) -- expected one of: 00 20 30 40 60)
endif

# The full 68020/030/040 assembly bundle. This is the established,
# hardware-validated path for 68030-class machines and MUST stay bit-for-bit
# what it was -- do not add/remove/reorder defines here without a matching
# 68030 hardware retest. CPU=20/30/40 use it verbatim; CPU=60 does NOT (see
# below). AMIGA_M68K_ASM_PLANARS8 was previously disabled here after
# real-hardware testing found true-stereo playback corrupted at both 11025 and
# 22050 with it on. Root cause was a wrong byte offset for the right channel in
# PlanarS8FromInterleavedStereo_Amiga_m68k (amiga_m68k_planars8.S) -- it read
# offset+1 (pcm[2i]'s own low byte) instead of offset+2 (pcm[2i+1]'s high
# byte). Fixed and hardware-confirmed clean with the flag off (C-only path);
# re-enabled here now that the asm kernel itself is ready for its own
# hardware retest.
CPU_ASM_CPPFLAGS_FULL030 := \
	-DAMIGA_M68K_ASM \
	-DAMIGA_M68K_ASM_FDCT32 \
	-DAMIGA_M68K_ASM_FDCT32_UNROLL \
	-DAMIGA_FAST_POLYPHASE \
	-DAMIGA_FAST_REDUCED_TAPS \
	-DAMIGA_FAST_FDCT32_QUARTER \
	-DAMIGA_M68K_IMDCT_THIN_OUTPUT \
	-DAMIGA_FAST_SUBBAND_CAP \
	-DAMIGA_M68K_ASM_POLYPHASE \
	-DAMIGA_M68K_ASM_IMDCT \
	-DAMIGA_M68K_ASM_ANTIALIAS \
	-DAMIGA_M68K_ASM_MIDSIDE \
	-DAMIGA_M68K_ASM_INTENSITY \
	-DAMIGA_M68K_ASM_DEQUANT \
	-DAMIGA_M68K_ASM_HUFFMAN \
	-DAMIGA_M68K_ASM_JPEG_GREY \
	-DAMIGA_M68K_ASM_PLANARS8
CPU_ASM_SOURCES_FULL030 := real/amiga_m68k_polyphase.S amiga_m68k_planars8.S

# ---------------------------------------------------------------------------
# 68060 feature groups (ASM60_GROUPS)
# ---------------------------------------------------------------------------
# On a real ~75 MHz 68060 the full030 bundle above is actively harmful: it is
# full of register-pair long multiplies (muls.l Dn,Dl:Dh) which the 68060 does
# not implement in hardware and traps into software emulation. In hot decoder
# loops (polyphase especially) that causes mouse-pointer lag, audio-buffer
# starvation and periodic dropouts -- worse than the plain C decoder.
#
# GCC's own -m68060 codegen already AVOIDS the emulated 64-bit muls.l for the C
# MULSHIFT32 reference (it calls __muldi3 instead), so a clean C CPU=60 build is
# the responsive-but-slow baseline. Every one of the flags in full030 above
# reintroduces the emulated instruction via hand-written .S / inline asm.
#
# Therefore CPU=60 does NOT inherit full030. It starts from the clean C
# baseline and lets each optimisation be enabled individually so it can be
# built, audited (tools/audit_68060_instructions.py) and hardware-tested on its
# own. Select groups with, e.g.:
#     make -f Makefile.amiga fast030 CPU=60 ASM60_GROUPS="huffman dequant"
# Nothing here is a public-release default; all CPU=60 asm groups are
# EXPERIMENTAL until validated on the physical 68060.
ASM60_GROUPS ?=

# group name -> extra -D defines
ASM60_FLAGS_huffman             := -DAMIGA_M68K_ASM_HUFFMAN
ASM60_FLAGS_dequant             := -DAMIGA_M68K_ASM_DEQUANT
ASM60_FLAGS_imdct               := -DAMIGA_M68K_ASM_IMDCT
ASM60_FLAGS_fdct32              := -DAMIGA_M68K_ASM_FDCT32 -DAMIGA_M68K_ASM_FDCT32_UNROLL
ASM60_FLAGS_antialias           := -DAMIGA_M68K_ASM_ANTIALIAS
ASM60_FLAGS_midside             := -DAMIGA_M68K_ASM_MIDSIDE
ASM60_FLAGS_intensity           := -DAMIGA_M68K_ASM_INTENSITY
ASM60_FLAGS_jpeg_grey           := -DAMIGA_M68K_ASM_JPEG_GREY
ASM60_FLAGS_planars8            := -DAMIGA_M68K_ASM_PLANARS8
# asm_core flips MULSHIFT32/CLZ/LOADBE16 globally to inline asm -- this alone
# reintroduces emulated muls.l everywhere MULSHIFT32 is used. Heavy; opt-in.
ASM60_FLAGS_asm_core            := -DAMIGA_M68K_ASM
# The five "fast" defines the earlier CPU=60 branch always enabled -- the ones
# responsible for the ~430 -> 3000+ jump in suspect instructions. Each is its
# own group here. Note the source-level dependencies (see real/polyphase.c,
# real/dct32.c, real/imdct.c): FDCT32_QUARTER and IMDCT_THIN_OUTPUT only take
# effect when AMIGA_FAST_POLYPHASE is also defined, so those groups pull it in
# to remain individually meaningful.
ASM60_FLAGS_fast_polyphase      := -DAMIGA_FAST_POLYPHASE
ASM60_FLAGS_fast_reduced_taps   := -DAMIGA_FAST_REDUCED_TAPS
ASM60_FLAGS_fast_subband_cap    := -DAMIGA_FAST_SUBBAND_CAP
ASM60_FLAGS_fast_fdct32_quarter := -DAMIGA_FAST_POLYPHASE -DAMIGA_FAST_FDCT32_QUARTER
ASM60_FLAGS_imdct_thin_output   := -DAMIGA_FAST_POLYPHASE -DAMIGA_M68K_IMDCT_THIN_OUTPUT
# asm_polyphase swaps the C fast-polyphase for the existing 68030 .S kernel.
# The task is explicit: do NOT re-enable this unchanged for CPU=60. It exists
# only as an opt-in A/B/audit knob, never in a default build.
ASM60_FLAGS_asm_polyphase       := -DAMIGA_FAST_POLYPHASE -DAMIGA_M68K_ASM_POLYPHASE
# poly060: the dedicated 68060 polyphase kernel (real/polyphase_68060.h). A
# distinct implementation that computes the same high multiply with
# hardware-only muls (Warren mulhs) instead of the emulated register pair.
# Correctness is covered by tests/polyphase60_ref_test.c. Experimental.
ASM60_FLAGS_poly060             := -DAMIGA_M68K_POLYPHASE_68060
# lowrate060: the 68060 polyphase kernel PLUS the whole downsampling fast path
# (stride synthesis, reduced taps, subband cap, fdct32 quarter, imdct thin) --
# the same work-reduction the CPU=30 fast build uses, but with poly060 making
# every per-tap multiply hardware-clean instead of the emulated register pair.
# This is what cuts real work when output rate < source rate (e.g. 22050 from a
# 44100 source), which the profiler shows dominates. Drop fast_reduced_taps for
# a longer (higher quality) polyphase filter at a little more cost.
ASM60_FLAGS_lowrate060          := -DAMIGA_M68K_POLYPHASE_68060 -DAMIGA_FAST_POLYPHASE \
	-DAMIGA_FAST_REDUCED_TAPS -DAMIGA_FAST_SUBBAND_CAP \
	-DAMIGA_FAST_FDCT32_QUARTER -DAMIGA_M68K_IMDCT_THIN_OUTPUT
# Meta group: reproduce the entire 030 bundle on CPU=60 (the known-bad
# "assembly-heavy" config) purely for A/B and audit baselining.
ASM60_FLAGS_full030             := $(CPU_ASM_CPPFLAGS_FULL030)

# group name -> extra .S sources
ASM60_SRC_planars8        := amiga_m68k_planars8.S
ASM60_SRC_asm_polyphase   := real/amiga_m68k_polyphase.S
ASM60_SRC_full030         := $(CPU_ASM_SOURCES_FULL030)

ASM60_KNOWN := huffman dequant imdct fdct32 antialias midside intensity \
	jpeg_grey planars8 asm_core fast_polyphase fast_reduced_taps \
	fast_subband_cap fast_fdct32_quarter imdct_thin_output asm_polyphase \
	poly060 lowrate060 full030

ifeq ($(CPU),00)
CPU_ASM_CPPFLAGS :=
CPU_ASM_SOURCES :=
else ifeq ($(CPU),60)
# Validate requested groups.
ASM60_BAD := $(filter-out $(ASM60_KNOWN),$(ASM60_GROUPS))
ifneq ($(ASM60_BAD),)
$(error Unknown ASM60_GROUPS: $(ASM60_BAD) -- valid groups: $(ASM60_KNOWN))
endif
# $(sort ...) both de-duplicates (groups sharing a define, or implied deps) and
# orders deterministically, so ASM60_GROUPS order never changes the flags.
CPU_ASM_CPPFLAGS := $(sort $(foreach g,$(ASM60_GROUPS),$(ASM60_FLAGS_$(g))))
CPU_ASM_SOURCES := $(sort $(foreach g,$(ASM60_GROUPS),$(ASM60_SRC_$(g))))
else
# 68020 / 68030 / 68040 -- established path, unchanged.
CPU_ASM_CPPFLAGS := $(CPU_ASM_CPPFLAGS_FULL030)
CPU_ASM_SOURCES := $(CPU_ASM_SOURCES_FULL030)
endif

STD ?= -std=gnu89
OPTFLAGS ?= -O2 -fomit-frame-pointer
TARGET ?= amiga_mp3dec
GUI_TARGET ?= MintAMP-GT
GUIR_TARGET ?= MintAMP
SKINGT_TARGET ?= MintAMP-SGT
SKINR_TARGET ?= MintAMP-SR
SKIN ?= 0

RELEASE_ROOT ?= release
RELEASE_NAME ?= MintAMP-2.0-dev-680$(CPU)
RELEASE_DIR := $(RELEASE_ROOT)/$(RELEASE_NAME)
RELEASE_ICON_SOURCE ?= artassets/MintAMP-v1.1-680$(CPU).info
RELEASE_README_SOURCE ?= MintAMP2.readme

CPPFLAGS_COMMON := -Ipub -Ireal -DAMIGA_M68K
CFLAGS_COMMON := $(CPU_MFLAG) $(STD) $(OPTFLAGS)
DECODER_SOURCES := mp3dec.c mp3tabs.c $(wildcard real/*.c)
RADIO_SOURCES :=
RADIO_CPPFLAGS :=
# The GUIs list radio_stream_probe.c themselves; the command-line player
# needs it too so it can follow redirects and .pls/.m3u station links.
RADIO_CLI_SOURCES :=
ifneq ($(filter 1 yes true on,$(RADIO) $(ENABLE_RADIO) $(HAVE_BSDSOCKET))$(findstring -DENABLE_RADIO,$(EXTRA_CFLAGS))$(findstring -DHAVE_BSDSOCKET,$(EXTRA_CFLAGS)),)
RADIO_SOURCES := radio_stream.c
RADIO_CPPFLAGS := -DENABLE_RADIO -DHAVE_BSDSOCKET
RADIO_CLI_SOURCES := radio_stream_probe.c
endif

# AmiSSL support: make -f Makefile.amiga fast030 RADIO=1 SSL=1
# Requires AmiSSL 4.x SDK headers in the cross-compiler sysroot.
# AmiSSL uses inline stubs via proto/amissl.h so no -l flag is needed.
SSL_CPPFLAGS :=
ifneq ($(filter 1 yes true on,$(SSL) $(HAVE_AMISSL))$(findstring -DHAVE_AMISSL,$(EXTRA_CFLAGS)),)
SSL_CPPFLAGS := -DHAVE_AMISSL
endif

# Opt-in: verify the radio stream's TLS certificate chain + hostname
# against AmiSSL's installed root CA bundle, instead of accepting any
# certificate (the long-standing default, kept as-is unless this is set).
# Requires SSL=1.  make -f Makefile.amiga fast030 RADIO=1 SSL=1 SSLCERTS=1
SSLCERTS_CPPFLAGS :=
ifneq ($(filter 1 yes true on,$(SSLCERTS))$(findstring -DRADIO_SSL_VERIFY_PEER,$(EXTRA_CFLAGS)),)
SSLCERTS_CPPFLAGS := -DRADIO_SSL_VERIFY_PEER
endif

PROBE_CPPFLAGS := -DRADIO_HAVE_STREAM_PROBE

DEBUG_CPPFLAGS :=
ifneq ($(filter 1 yes true on,$(DEBUG)),)
DEBUG_CPPFLAGS := -DRADIO_DEBUG
endif

# libnix ___free_all compatibility replacement (crt_freeall_probe.c).
# The GUI rules build a temporary discovery binary, extract the three list-head
# addresses from that exact binary's stock ___free_all disassembly, then relink
# the final binary with those addresses supplied as absolute --defsym symbols.
# FREEALL_PROBE=1 enables verbose raw diagnostics in the same replacement.
LIBNIX_FREEALL_COMPAT_SOURCES := crt_freeall_probe.c
FREEALL_PROBE_CPPFLAGS :=
ifneq ($(filter 1 yes true on,$(FREEALL_PROBE)),)
FREEALL_PROBE_CPPFLAGS := -DFREEALL_PROBE
endif
FREEALL_DISCOVERY_LDFLAGS := -Wl,--defsym,___freeall_head0=0 \
	-Wl,--defsym,___freeall_head1=0 \
	-Wl,--defsym,___freeall_head2=0
FREEALL_HEAD_EXTRACT := python3 tools/libnix_freeall_heads.py

# Debug-only heap guard for MintAMP's own allocations (front/rear guard
# bytes, double-free and leak detection -- see miniamp_memguard.c).
# Independent of DEBUG=1 above; combine as e.g. `make ... DEBUG=1 HEAPGUARD=1`.
# Never affects a normal (release) build: without this, miniamp_memguard.c
# compiles to nothing and malloc/calloc/realloc/free are untouched.
ifneq ($(filter 1 yes true on,$(HEAPGUARD)),)
DEBUG_CPPFLAGS += -DMINIAMP_DEBUG_ALLOC
endif

# Process-wide task-safe C allocator (amiga_tasksafe_malloc.c). This program
# runs the GUI task, every playback child and the AmiSSL net worker inside one
# loaded image, all sharing libnix's single UNLOCKED malloc arena, which is not
# task-safe; concurrent malloc/free from two of those tasks corrupts the arena
# and, downstream, the Exec free list. Overriding malloc/calloc/realloc/free
# with strong AllocVec/FreeVec-backed symbols (Exec-serialised) removes that
# shared arena from every task in EVERY build (unlike HEAPGUARD, which only
# serialises MiniMem-wrapped allocations in debug builds). On by default;
# TASKSAFEMALLOC=0 reverts to libnix's allocator for A/B testing.
TASKSAFEMALLOC ?= 1
ifneq ($(filter 1 yes true on,$(TASKSAFEMALLOC)),)
CPPFLAGS_COMMON += -DAMIGA_TASKSAFE_MALLOC
TASKSAFE_MALLOC_SOURCE := amiga_tasksafe_malloc.c
else
TASKSAFE_MALLOC_SOURCE :=
endif

# PNG favicon decoding for the radio artwork feature (lvandeve/lodepng,
# vendored as lodepng.c/.h).  Used by both the MintAMP (ReAction) and the
# amiga_mp3gui (GadTools) frontends.  Decoder-only, no encoder/disk-IO/
# ancillary chunk support compiled in -- both frontends feed it an
# in-memory buffer directly, same as the JPEG path.  Disable with
# -DENABLE_PNG_ARTWORK=0 in EXTRA_CFLAGS and drop lodepng.c from the
# relevant *_SOURCES below to also shrink the binary; the C-level guard
# alone only skips the decode calls.
PNG_CPPFLAGS := -DENABLE_PNG_ARTWORK -DLODEPNG_NO_COMPILE_ENCODER \
	-DLODEPNG_NO_COMPILE_DISK -DLODEPNG_NO_COMPILE_ANCILLARY_CHUNKS

# SVG favicon decoding (svgdec.c, a small from-scratch fixed-point subset
# decoder -- no floating point, no third-party library, see svgdec.h).  Now
# linked into both frontends.  Disable with -DENABLE_SVG_ARTWORK=0 in
# EXTRA_CFLAGS and drop svgdec.c from the *_SOURCES below to also shrink
# the binary; the C-level guard alone only skips the decode calls.
#
# WebP favicon decoding (webpdec.c, a small from-scratch VP8 lossy + VP8L
# lossless decoder -- no third-party library, see webpdec.h).  Linked into
# both frontends.  Disable with -DENABLE_WEBP_ARTWORK=0 in EXTRA_CFLAGS and
# drop webpdec.c from the *_SOURCES below; the C-level guard alone only skips
# the decode calls.  WebP is the second most common real-world favicon format.

SOURCES := amiga_mp3dec.c miniamp_memguard.c $(TASKSAFE_MALLOC_SOURCE) radio_runtime_flags.c $(RADIO_SOURCES) $(RADIO_CLI_SOURCES) $(DECODER_SOURCES)
# miniamp_memguard.c compiles to nothing unless HEAPGUARD=1 (see
# MINIAMP_DEBUG_ALLOC above), so it's harmless to always list it.
GUI_SOURCES := interface_prefs.c launch_options.c amiga_mp3gui.c picojpeg.c lodepng.c webpdec.c svgdec.c miniamp_memguard.c $(TASKSAFE_MALLOC_SOURCE) radio_runtime_flags.c $(RADIO_SOURCES) \
	radio_browser_controller.c radio_browser.c radio_browser_url.c \
	radio_browser_http.c radio_browser_json.c radio_stream_probe.c
# MintAMP-GT uses gadtools.library via proto/gadtools.h; no linker flag is needed.
# MintAMP is the ReAction/ClassAct frontend; it pulls amiga_mp3dec.c in itself
# (like amiga_mp3gui.c) so only the shared decoder modules are listed here.  The
# ReAction classes are opened at runtime, so no extra linker flag is needed.
# lodepng.c/webpdec.c/svgdec.c are linked into both frontends now, so the
# GadTools and ReAction builds decode the same favicon formats (JPEG, PNG,
# WebP, ICO and SVG).
GUIR_SOURCES := interface_prefs.c launch_options.c minimp3r.c picojpeg.c lodepng.c webpdec.c svgdec.c miniamp_memguard.c $(TASKSAFE_MALLOC_SOURCE) radio_runtime_flags.c $(RADIO_SOURCES) \
	radio_browser_controller.c radio_browser.c radio_browser_url.c \
	radio_browser_http.c radio_browser_json.c radio_stream_probe.c

SKIN_SOURCES := winamp_skin.c winamp_skin_render.c skin_player.c skin_controls.c
SKIN_HEADERS := winamp_skin.h skin_player.h skin_controls.h skin_playlist_actions.inc skin_gadtools.inc skin_reaction.inc
ifeq ($(SKIN),1)
CPPFLAGS_COMMON += -DMINTAMP_SKIN
GUI_SOURCES += $(SKIN_SOURCES)
GUIR_SOURCES += $(SKIN_SOURCES)
GUI_EXTRA_DEPS := $(SKIN_HEADERS)
endif

# FAST030_* names are kept for backward compatibility (every target rule
# below still refers to them) even though they're no longer hardcoded to
# -m68030 -- the actual CPU is now CPU_MFLAG/CPU_ASM_*, set above from the
# numeric CPU= variable.
FAST030_CPPFLAGS := $(CPU_ASM_CPPFLAGS)
FAST030_CFLAGS := $(CPU_MFLAG) $(STD) -O3 -fomit-frame-pointer
FAST030_TARGET := amiga_mp3dec.fastexp
PROF030_TARGET := amiga_mp3dec.prof
PROF030_CPPFLAGS := -DAMIGA_PROFILE_DECODE -DHAVE_AMIGA_AUDIO_DEVICE
FAST030_HALFASM_TEST_TARGET := amiga_mp3dec.fdcthalf-test
GUI_HALFASM_TEST_TARGET := MintAMP-GT.fdcthalf-test
HALFASM_TEST_CPPFLAGS := -DAMIGA_M68K_ASM_FDCT32
FAST030_ASM_SOURCES := $(CPU_ASM_SOURCES)
AMIGA_HUNK_FAST_PREFERRED := python3 tools/amiga_fast_preferred_hunks.py

.PHONY: skins sgt sr sslsgt sslsr skin-format-test all fast030 radio030 sslradio030 amissl-get-test amissl-free-repro-test amissl-spawn-repro-test amissl-exec-repro-test rb-stream-probe-test prof030 gui guir miniamp3 minimp3r sslgui sslguir fast030-halfasm-test gui-halfasm-test decoder-modules release release-clean clean print-command print-fast030-command print-gui-command print-guir-command cpu60-baseline cpu60-huffman cpu60-huffman-dequant cpu60-huffman-dequant-imdct cpu60-huffman-dequant-imdct-fdct32 cpu60-audit-stages poly60-ref-test aac-mulshift60-ref-test ogg-mulshift60-ref-test wma-mulshift-ref-test flac-lpc-ref-test radio-metadata-test radio-oggflac-test playlist-format-test display-text-test radio-favourites-test freeall-heads-test

all: $(TARGET) decoder-modules

$(TARGET): $(SOURCES) integer_stats.h
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ $(SOURCES)
	$(AMIGA_HUNK_FAST_PREFERRED) $@

fast030: $(FAST030_TARGET) decoder-modules

radio030:
	$(MAKE) -f Makefile.amiga fast030 RADIO=1

sslradio030:
	$(MAKE) -f Makefile.amiga fast030 RADIO=1 SSL=1

amissl-get-test: amissl_https_get

amissl-free-repro-test: amissl_ssl_free_repro amissl_spawn_repro amissl_exec_repro amissl_child_worker_repro

amissl-spawn-repro-test: amissl_spawn_repro

amissl-exec-repro-test: amissl_exec_repro amissl_child_worker_repro

rb-stream-probe-test: rb_stream_probe_test

# Standalone AmiSSL smoke test: deliberately links only this file and no
# libamisslauto so manual OpenLibrary/InitAmiSSLMaster/OpenAmiSSL remains
# unambiguous while debugging library vector crashes.
amissl_https_get: amissl_https_get.c
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) -DHAVE_AMISSL $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ amissl_https_get.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

# Minimal SSL_free()-after-SSL_ERROR_SYSCALL reproducer for the AmiSSL bug
# report (docs/amissl-lifecycle-audit.md has the full lifecycle audit this
# file's approach is based on). See amissl_ssl_free_repro.c's header comment
# for MP3_REPRO_MODE/MP3_REPRO_STATION_FILE/etc.
amissl_ssl_free_repro: amissl_ssl_free_repro.c
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) -DHAVE_AMISSL $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ amissl_ssl_free_repro.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

# Parent/child AmiSSL concurrency repro: parent owns the shared AmiSSL instance
# while a CreateNewProcTags() child reuses the same SocketBase/AmiSSL_ErrNoPtr
# and both perform HTTPS connect/read/free churn concurrently.
amissl_spawn_repro: amissl_spawn_repro.c
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) -DHAVE_AMISSL $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ amissl_spawn_repro.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

# Separate-executable repro pair: the launcher starts the worker via RUN so the
# child is a distinct program with its own data segment, SocketBase and
# AmiSSL_ErrNoPtr. This confirms whether the CreateNewProcTags child hang is
# caused by reusing parent/global socket state.
amissl_exec_repro: amissl_exec_repro.c
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) -DHAVE_AMISSL $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ amissl_exec_repro.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

amissl_child_worker_repro: amissl_child_worker_repro.c
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) -DHAVE_AMISSL $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ amissl_child_worker_repro.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

rb_stream_probe_test: radio_stream_probe.c radio_stream_probe.h radio_runtime_flags.c radio_runtime_flags.h
	$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) $(SSL_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -DRB_STREAM_PROBE_TEST -o $@ radio_stream_probe.c radio_runtime_flags.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@

sslgui:
	$(MAKE) -f Makefile.amiga gui RADIO=1 SSL=1

sslguir:
	$(MAKE) -f Makefile.amiga guir RADIO=1 SSL=1

prof030: $(PROF030_TARGET)

# Separate executables reuse the existing frontend/link recipes, including
# task-safe allocation and the exact-binary libnix ___free_all fix.
sgt:
	$(MAKE) -f Makefile.amiga gui SKIN=1 GUI_TARGET="$(SKINGT_TARGET)"
sr:
	$(MAKE) -f Makefile.amiga guir SKIN=1 GUIR_TARGET="$(SKINR_TARGET)"
skins: sgt sr

.PHONY: launcher
launcher: MintAMP-Launch
MintAMP-Launch: mintamp_launch.c interface_prefs.c launch_options.c interface_prefs.h launch_options.h
	$(CC) $(CPU_MFLAG) $(STD) -Os $(EXTRA_CFLAGS) -o $@ mintamp_launch.c interface_prefs.c launch_options.c
	$(AMIGA_HUNK_FAST_PREFERRED) $@
sslsgt:
	$(MAKE) -f Makefile.amiga sgt RADIO=1 SSL=1
sslsr:
	$(MAKE) -f Makefile.amiga sr RADIO=1 SSL=1
ifneq ($(SKIN),1)
$(SKINGT_TARGET): sgt
$(SKINR_TARGET): sr
endif

skin-format-test:
	$(HOSTCC) -O2 -std=gnu99 -Wall -Wextra -Werror -I. -DLODEPNG_NO_COMPILE_ENCODER \
		-DLODEPNG_NO_COMPILE_DISK tests/winamp_skin_test.c winamp_skin.c \
		winamp_skin_render.c lodepng.c -o skin_format_test
	python3 tests/winamp_skin_test.py $(SKIN_TEST_FILE)

gui: $(GUI_TARGET) decoder-modules

guir: $(GUIR_TARGET) decoder-modules

miniamp3: gui

minimp3r: guir

fast030-halfasm-test: $(FAST030_HALFASM_TEST_TARGET)

gui-halfasm-test: $(GUI_HALFASM_TEST_TARGET)

$(GUI_TARGET): interface_prefs.h launch_options.h $(GUI_EXTRA_DEPS) $(GUI_SOURCES) amiga_mp3dec.c integer_stats.h gadtools_radio_layout.h $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES)
	set -e; \
	trap 'rm -f $@.freeall-discovery $@.freeall-heads' EXIT; \
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PROBE_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(PNG_CPPFLAGS) $(DEBUG_CPPFLAGS) $(FREEALL_PROBE_CPPFLAGS) $(EXTRA_CFLAGS) \
		-o $@.freeall-discovery $(GUI_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES) $(FREEALL_DISCOVERY_LDFLAGS); \
	$(FREEALL_HEAD_EXTRACT) --shell $@.freeall-discovery > $@.freeall-heads; \
	. ./$@.freeall-heads; \
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PROBE_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(PNG_CPPFLAGS) $(DEBUG_CPPFLAGS) $(FREEALL_PROBE_CPPFLAGS) $(EXTRA_CFLAGS) \
		-o $@ $(GUI_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES) $$FREEALL_LDFLAGS; \
	$(FREEALL_HEAD_EXTRACT) $@ --verify $$FREEALL_HEAD0 $$FREEALL_HEAD1 $$FREEALL_HEAD2; \
	rm -f $@.freeall-discovery $@.freeall-heads; \
	trap - EXIT
	$(AMIGA_HUNK_FAST_PREFERRED) $@

# MintAMP — ReAction/ClassAct frontend.  Built with the same fast030 ASM path
# as the GadTools GUI since it targets 030+/3.5/3.9 machines.  minimp3r.c
# #includes amiga_mp3dec.c, so only the shared decoder modules are linked.
$(GUIR_TARGET): interface_prefs.h launch_options.h $(GUI_EXTRA_DEPS) $(GUIR_SOURCES) amiga_mp3dec.c integer_stats.h $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES)
	set -e; \
	trap 'rm -f $@.freeall-discovery $@.freeall-heads' EXIT; \
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PROBE_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(PNG_CPPFLAGS) $(DEBUG_CPPFLAGS) $(FREEALL_PROBE_CPPFLAGS) $(EXTRA_CFLAGS) \
		-o $@.freeall-discovery $(GUIR_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES) $(FREEALL_DISCOVERY_LDFLAGS); \
	$(FREEALL_HEAD_EXTRACT) --shell $@.freeall-discovery > $@.freeall-heads; \
	. ./$@.freeall-heads; \
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PROBE_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(PNG_CPPFLAGS) $(DEBUG_CPPFLAGS) $(FREEALL_PROBE_CPPFLAGS) $(EXTRA_CFLAGS) \
		-o $@ $(GUIR_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES) $(LIBNIX_FREEALL_COMPAT_SOURCES) $$FREEALL_LDFLAGS; \
	$(FREEALL_HEAD_EXTRACT) $@ --verify $$FREEALL_HEAD0 $$FREEALL_HEAD1 $$FREEALL_HEAD2; \
	rm -f $@.freeall-discovery $@.freeall-heads; \
	trap - EXIT
	$(AMIGA_HUNK_FAST_PREFERRED) $@

$(FAST030_TARGET): $(SOURCES) integer_stats.h $(FAST030_ASM_SOURCES)
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ $(SOURCES) $(FAST030_ASM_SOURCES)
	$(AMIGA_HUNK_FAST_PREFERRED) $@

# Same as fast030 but with AMIGA_PROFILE_DECODE, so --bench prints the per-bucket
# core timing split (huffman/dequant/imdct/subband-dct32/polyphase/stereo).
# The clock() calls add overhead, so use it for relative bucket sizing, not for
# absolute realtime numbers.
$(PROF030_TARGET): $(SOURCES) integer_stats.h $(FAST030_ASM_SOURCES)
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PROF030_CPPFLAGS) $(SSL_CPPFLAGS) $(SSLCERTS_CPPFLAGS) $(DEBUG_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ $(SOURCES) $(FAST030_ASM_SOURCES)
	$(AMIGA_HUNK_FAST_PREFERRED) $@

$(FAST030_HALFASM_TEST_TARGET): $(SOURCES) integer_stats.h $(FAST030_ASM_SOURCES)
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(HALFASM_TEST_CPPFLAGS) $(EXTRA_CFLAGS) -o $@ $(SOURCES) $(FAST030_ASM_SOURCES)
	$(AMIGA_HUNK_FAST_PREFERRED) $@

$(GUI_HALFASM_TEST_TARGET): $(GUI_SOURCES) amiga_mp3dec.c integer_stats.h $(DECODER_SOURCES) $(FAST030_ASM_SOURCES)
	$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(HALFASM_TEST_CPPFLAGS) $(PNG_CPPFLAGS) $(EXTRA_CFLAGS) \
		-o $@ $(GUI_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES)
	$(AMIGA_HUNK_FAST_PREFERRED) $@

print-command:
	@printf '%s\n' '$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(EXTRA_CFLAGS) -o $(TARGET) $(SOURCES)'
	@printf '%s\n' '$(AMIGA_HUNK_FAST_PREFERRED) $(TARGET)'

print-gui-command:
	@printf '%s\n' '$(CC) $(CFLAGS_COMMON) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(PNG_CPPFLAGS) $(EXTRA_CFLAGS) -o $(GUI_TARGET) $(GUI_SOURCES)'
	@printf '%s\n' '$(AMIGA_HUNK_FAST_PREFERRED) $(GUI_TARGET)'

print-guir-command:
	@printf '%s\n' '$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(PNG_CPPFLAGS) $(EXTRA_CFLAGS) -o $(GUIR_TARGET) $(GUIR_SOURCES) $(DECODER_SOURCES) $(FAST030_ASM_SOURCES)'
	@printf '%s\n' '$(AMIGA_HUNK_FAST_PREFERRED) $(GUIR_TARGET)'

print-fast030-command:
	@printf '%s\n' '$(CC) $(FAST030_CFLAGS) $(CPPFLAGS_COMMON) $(RADIO_CPPFLAGS) $(FAST030_CPPFLAGS) $(EXTRA_CFLAGS) -o $(FAST030_TARGET) $(SOURCES) $(FAST030_ASM_SOURCES)'
	@printf '%s\n' '$(AMIGA_HUNK_FAST_PREFERRED) $(FAST030_TARGET)'

# ---------------------------------------------------------------------------
# CPU=60 audit / experiment build targets
# ---------------------------------------------------------------------------
# Repeatable, separately-named CPU=60 decoder binaries so each optimisation can
# be built and audited on its own against the clean C baseline. These build the
# fast030 command-line decoder (SOURCES only, no decoder-modules) so the audit
# focuses on the MP3 decode hot path. NONE of these is a public-release default
# -- they are experimental until validated on the physical 68060.
#
# Each target overrides FAST030_TARGET so the output filename is distinct, and
# passes CPU=60 with the matching ASM60_GROUPS. Example manual form:
#     make -f Makefile.amiga fast030 CPU=60 ASM60_GROUPS="huffman" \
#          FAST030_TARGET=amiga_mp3dec.cpu60-huffman
#
# tools/audit_68060_instructions.py consumes these binaries; run e.g.
#     make -f Makefile.amiga cpu60-audit-huffman OBJDUMP=m68k-amigaos-objdump
CPU60_PREFIX ?= amiga_mp3dec.cpu60

# $(call cpu60_build,<suffix>,<groups>) -- recursively build one CPU=60 config.
define cpu60_build
$(MAKE) -f Makefile.amiga CPU=60 ASM60_GROUPS="$(2)" \
	FAST030_TARGET=$(CPU60_PREFIX)-$(1) $(CPU60_PREFIX)-$(1)
endef

cpu60-baseline:
	$(call cpu60_build,baseline,)

cpu60-huffman:
	$(call cpu60_build,huffman,huffman)

cpu60-huffman-dequant:
	$(call cpu60_build,huffman-dequant,huffman dequant)

cpu60-huffman-dequant-imdct:
	$(call cpu60_build,huffman-dequant-imdct,huffman dequant imdct)

cpu60-huffman-dequant-imdct-fdct32:
	$(call cpu60_build,huffman-dequant-imdct-fdct32,huffman dequant imdct fdct32)

# Build a single named optimisation group in isolation, e.g.
#     make -f Makefile.amiga cpu60-group-fast_polyphase
cpu60-group-%:
	$(MAKE) -f Makefile.amiga CPU=60 ASM60_GROUPS="$*" \
		FAST030_TARGET=$(CPU60_PREFIX)-group-$* $(CPU60_PREFIX)-group-$*

# Build the clean baseline + one isolated group and diff them symbol-for-symbol.
cpu60-audit-%: cpu60-baseline cpu60-group-%
	python3 tools/audit_68060_instructions.py --objdump "$(OBJDUMP)" \
		--baseline $(CPU60_PREFIX)-baseline \
		--candidate $(CPU60_PREFIX)-group-$*

# Audit the staged huffman/dequant/imdct progression against the baseline.
cpu60-audit-stages: cpu60-baseline cpu60-huffman cpu60-huffman-dequant cpu60-huffman-dequant-imdct
	@for c in huffman huffman-dequant huffman-dequant-imdct; do \
		echo "===== $(CPU60_PREFIX)-$$c vs baseline ====="; \
		python3 tools/audit_68060_instructions.py --objdump "$(OBJDUMP)" \
			--baseline $(CPU60_PREFIX)-baseline \
			--candidate $(CPU60_PREFIX)-$$c || exit $$?; \
	done

# Host correctness test for the 68060 polyphase kernel. Builds with the native
# compiler (not the m68k cross-compiler) because MulShift68060 is portable C and
# gives identical results on any platform; it compares the kernel's PCM output
# against the bit-exact 64-bit reference polyphase and fails if the error
# exceeds its documented bound. The separate "no emulated muls.l" check is done
# by disassembling an -m68060 build with tools/audit_68060_instructions.py.
HOSTCC ?= cc
poly60-ref-test:
	$(HOSTCC) -O2 -Ipub -Ireal -DAMIGA_M68K \
		tests/polyphase60_ref_test.c real/trigtabs.c -o polyphase60_ref_test
	./polyphase60_ref_test

# Host bit-exactness test for the 68060 AAC high-half multiply.  The test-mode
# multiply primitives are portable C; production CPU=60 builds substitute the
# hardware two-operand MULS.L/MULU.L form for precisely those operations.
aac-mulshift60-ref-test:
	$(HOSTCC) -O2 -std=gnu99 tests/aac_mulshift60_ref_test.c \
		-o aac_mulshift60_ref_test
	./aac_mulshift60_ref_test

# Host bit-exactness test for Tremor's CPU=60 MULT32/MULT31/SHIFT15 helpers.
ogg-mulshift60-ref-test:
	$(HOSTCC) -O2 -std=gnu99 tests/ogg_mulshift60_ref_test.c \
		-o ogg_mulshift60_ref_test
	./ogg_mulshift60_ref_test

# Verify both WMA CPU backends against the exact signed 64-bit reference.
wma-mulshift-ref-test:
	$(HOSTCC) -O2 -std=gnu99 -DMINTAMP_WMA_TEST_030 \
		tests/wma_mulshift_ref_test.c -o wma_mulshift030_ref_test
	./wma_mulshift030_ref_test
	$(HOSTCC) -O2 -std=gnu99 -DMINTAMP_WMA_TEST_060 \
		tests/wma_mulshift_ref_test.c -o wma_mulshift060_ref_test
	./wma_mulshift060_ref_test

# Verify the complete 64-bit LPC accumulator and restored samples on both CPUs.
flac-lpc-ref-test:
	$(HOSTCC) -O2 -std=gnu99 -DMINTAMP_FLAC_TEST_030 \
		tests/flac_lpc_ref_test.c -o flac_lpc030_ref_test
	./flac_lpc030_ref_test
	$(HOSTCC) -O2 -std=gnu99 -DMINTAMP_FLAC_TEST_060 \
		tests/flac_lpc_ref_test.c -o flac_lpc060_ref_test
	./flac_lpc060_ref_test

# Host decode test for MPEG-2.5 Layer III (8/11.025/12 kHz). Helix carries the
# tables for it, but pub/mp3common.h chooses between an 11-bit syncword (which
# matches MPEG-2.5 frames as well as MPEG-1/2) and a 12-bit one (which does
# not); with the 12-bit form those files decoded to nothing at all. This pins
# the choice and the decode behind it.
mpeg25-decode-test:
	$(HOSTCC) -O2 -std=gnu99 -DAMIGA_M68K -Ipub -Ireal \
		tests/mpeg25_decode_test.c mp3dec.c mp3tabs.c real/*.c \
		-o mpeg25_decode_test
	./mpeg25_decode_test

# Host test for bounded ICY RadioInfo XML extraction. Bauer's streams place a
# full XML document in StreamTitle; this must never reach the GUI as markup.
radio-metadata-test:
	$(HOSTCC) -O2 -std=gnu99 tests/radio_metadata_test.c \
		-o radio_metadata_test
	./radio_metadata_test

# Host test for the Ogg FLAC -> native FLAC converter used by lossless radio.
radio-oggflac-test:
	$(HOSTCC) -O2 -std=gnu99 tests/radio_oggflac_test.c \
		-o radio_oggflac_test
	./radio_oggflac_test

# Host test for converting internet text (station names, ICY titles) for
# the Amiga's Latin-1 fonts.
display-text-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra tests/display_text_test.c \
		-o display_text_test
	./display_text_test

# Host test for the one-variable radio favourites format.
radio-favourites-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra tests/radio_favourites_test.c \
		-o radio_favourites_test
	./radio_favourites_test

# Host test for M3U/PLS playlist reading and writing used by both GUIs.
playlist-format-test:
	$(HOSTCC) -O2 -std=gnu99 tests/playlist_format_test.c \
		-o playlist_format_test
	./playlist_format_test

# The GUI release links need tools/libnix_freeall_heads.py to read every
# objdump layout of libnix's ___free_all; checked here on fixed dumps.
freeall-heads-test:
	PYTHONDONTWRITEBYTECODE=1 python3 tests/libnix_freeall_heads_test.py

# Build all decoder modules (FLAC and AAC) — requires upstream decoder libraries.
# CPU is forwarded as the same numeric 00/20/30/40/60 code used above so
# decoders/Makefile derives the matching -mCPU flag itself; CFLAGS is
# deliberately NOT forwarded here -- decoders/Makefile's own `override
# CFLAGS` is self-sufficient (it already includes -DHAVE_AMIGA_AUDIO_DEVICE
# and -DAMIGA_M68K) and forwarding a CFLAGS= from here would have overridden
# it via normal GNU Make command-line precedence, silently dropping the
# -fno-builtin-*/-ffunction-sections flags those modules actually need --
# see the comment on `override CFLAGS` in decoders/Makefile.
decoder-modules:
	$(MAKE) -C decoders \
		CC="$(CC)" \
		CPU="$(CPU)" \
		AACASM="$(AACASM)" \
		WMAASM="$(WMAASM)" \
		FLACASM="$(FLACASM)"

# Build a self-contained Amiga application drawer suitable for LhA/Aminet
# packaging. MintAMP is the ReAction frontend; MintAMP-GT is the GadTools
# fallback; amiga_mp3dec.fastexp is the fast command-line edition. The
# applications create PROGDIR:ArtCache themselves when needed, but the empty
# drawer is included here for a tidy unpacked layout.
release: launcher skins $(GUIR_TARGET) $(GUI_TARGET) $(FAST030_TARGET) decoder-modules Skins/MintAMP-mintleaf.wsz
	rm -rf "$(RELEASE_DIR)"
	mkdir -p "$(RELEASE_DIR)/decoders" "$(RELEASE_DIR)/ArtCache" "$(RELEASE_DIR)/Skins" "$(RELEASE_DIR)/docs"
	@test -f "$(RELEASE_ICON_SOURCE)" || { echo "ERROR: missing drawer icon $(RELEASE_ICON_SOURCE)"; exit 1; }
	@test -f "$(RELEASE_README_SOURCE)" || { echo "ERROR: missing release readme $(RELEASE_README_SOURCE)"; exit 1; }
	cp "$(RELEASE_ICON_SOURCE)" "$(RELEASE_ROOT)/$(RELEASE_NAME).info"
	cp "$(RELEASE_README_SOURCE)" "$(RELEASE_ROOT)/MintAMP.readme"
	cp "$(RELEASE_README_SOURCE)" "$(RELEASE_DIR)/ReadMe"
	@test -f "$(FAST030_TARGET)" || { echo "ERROR: missing $(FAST030_TARGET)"; exit 1; }
	cp MintAMP-Launch "$(GUIR_TARGET)" "$(GUI_TARGET)" "$(SKINGT_TARGET)" "$(SKINR_TARGET)" "$(FAST030_TARGET)" "$(RELEASE_DIR)/"
	@test -f "$(GUIR_TARGET).info" || { echo "ERROR: missing $(GUIR_TARGET).info"; exit 1; }
	@test -f "$(GUI_TARGET).info" || { echo "ERROR: missing $(GUI_TARGET).info"; exit 1; }
	cp MintAMP-Launch.info "$(GUIR_TARGET).info" "$(GUI_TARGET).info" "$(SKINGT_TARGET).info" "$(SKINR_TARGET).info" "$(RELEASE_DIR)/"
	cp docs/winamp-skins.md "$(RELEASE_DIR)/Skins/ReadMe"
	cp docs/winamp-skins.md docs/mintamp-2.0-acceptance.md "$(RELEASE_DIR)/docs/"
	cp BUILD-RELEASE.txt "$(RELEASE_DIR)/docs/"
	cp Skins/MintAMP-mintleaf.wsz "$(RELEASE_DIR)/Skins/"
	@set -e; \
	found=0; \
	for decoder in decoders/*.decoder; do \
		if test -f "$$decoder"; then \
			cp "$$decoder" "$(RELEASE_DIR)/decoders/"; \
			found=1; \
		fi; \
	done; \
	if test "$$found" -eq 0; then \
		echo "ERROR: no decoder modules found in decoders/"; \
		exit 1; \
	fi
	@for file in LICENSE LICENSE.txt COPYING CHANGELOG.md; do \
		if test -f "$$file"; then cp "$$file" "$(RELEASE_DIR)/"; fi; \
	done
	@echo "Release drawer created: $(RELEASE_DIR)"
	@echo "Release drawer icon: $(RELEASE_ROOT)/$(RELEASE_NAME).info"
	@echo "Aminet readme: $(RELEASE_ROOT)/MintAMP.readme"
	@find "$(RELEASE_ROOT)" -maxdepth 2 -type f -print | sort

release-clean:
	rm -rf "$(RELEASE_ROOT)"

clean:
	rm -f MintAMP-Launch interface_prefs_test launch_options_test skin_performance_test skin_sprite_test skin_controls_test skin_eq_decode_test integer_stats_test gadtools_radio_layout_test display_text_test radio_favourites_test $(SKINGT_TARGET) $(SKINR_TARGET) skin_format_test $(TARGET) $(FAST030_TARGET) $(PROF030_TARGET) $(FAST030_HALFASM_TEST_TARGET) $(GUI_TARGET) $(GUIR_TARGET) $(GUI_TARGET).freeall-discovery $(GUIR_TARGET).freeall-discovery $(GUI_TARGET).freeall-heads $(GUIR_TARGET).freeall-heads $(GUI_HALFASM_TEST_TARGET) \
		amissl_https_get amissl_ssl_free_repro amissl_spawn_repro amissl_exec_repro amissl_child_worker_repro rb_stream_probe_test \
		aac_mulshift60_ref_test ogg_mulshift60_ref_test wma_mulshift030_ref_test wma_mulshift060_ref_test \
		flac_lpc030_ref_test flac_lpc060_ref_test polyphase60_ref_test radio_metadata_test radio_oggflac_test playlist_format_test \
		mpeg25_decode_test
	$(MAKE) -C decoders clean

.PHONY: skin-controls-test skin-eq-decode-test integer-stats-test gadtools-radio-layout-test

gadtools-radio-layout-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. tests/gadtools_radio_layout_test.c -o gadtools_radio_layout_test
	./gadtools_radio_layout_test
integer-stats-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. tests/integer_stats_test.c -o integer_stats_test
	./integer_stats_test
	PYTHONDONTWRITEBYTECODE=1 python3 tests/integer_source_test.py
skin-controls-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. tests/skin_controls_test.c skin_controls.c winamp_skin_render.c -o skin_controls_test
	./skin_controls_test
skin-eq-decode-test:
	$(HOSTCC) -O2 -std=gnu99 -DAMIGA_M68K -DMINTAMP_SKIN -I. -Ipub -Ireal tests/skin_eq_decode_test.c mp3dec.c mp3tabs.c real/*.c skin_controls.c -o skin_eq_decode_test
	./skin_eq_decode_test

.PHONY: launcher-test
launcher-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. tests/launch_options_test.c launch_options.c -o launch_options_test
	./launch_options_test
	PYTHONDONTWRITEBYTECODE=1 python3 tests/launcher_icon_test.py

.PHONY: skin-performance-test
skin-performance-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. -DLODEPNG_NO_COMPILE_ENCODER -DLODEPNG_NO_COMPILE_DISK tests/skin_performance_test.c skin_controls.c winamp_skin.c winamp_skin_render.c lodepng.c -o skin_performance_test
	./skin_performance_test

.PHONY: skin-sprite-test
skin-sprite-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -I. tests/skin_sprite_test.c winamp_skin_render.c -o skin_sprite_test
	./skin_sprite_test

.PHONY: interface-prefs-test
interface-prefs-test:
	$(HOSTCC) -O2 -std=gnu89 -Wall -Wextra -Werror -DMINTAMP_PREFS_TEST -I. tests/interface_prefs_test.c interface_prefs.c launch_options.c -o interface_prefs_test
	./interface_prefs_test
